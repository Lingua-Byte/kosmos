{
  "name": "kosmos",
  "productName": "KOSMOS",
  "version": "1.0.0",
  "description": "KOSMOS — Convergência Cósmica (app de PC)",
  "author": "Lingua-Byte",
  "main": "main.js",
  "scripts": {
    "iniciar": "electron .",
    "exe": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "io.github.linguabyte.kosmos",
    "productName": "KOSMOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "offline.html",
      "icone.png"
    ],
    "win": {
      "icon": "icone.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "KOSMOS-portatil.exe"
    },
    "nsis": {
      "artifactName": "KOSMOS-instalador.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "KOSMOS"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
